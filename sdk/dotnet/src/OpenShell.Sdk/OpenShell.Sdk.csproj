<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
    SPDX-License-Identifier: Apache-2.0
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>OpenShell</RootNamespace>
    <AssemblyName>OpenShell.Sdk</AssemblyName>
    <PackageId>OpenShell.Sdk</PackageId>
    <Description>.NET client for the OpenShell gateway.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- CA1708: the proto package `openshell.v1` generates the `Openshell` namespace, which differs from the public `OpenShell` namespace only by case. -->
    <NoWarn>$(NoWarn);CA1708</NoWarn>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/NVIDIA/OpenShell</RepositoryUrl>
    <InternalsVisibleToTests>OpenShell.Sdk.Tests</InternalsVisibleToTests>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Proto sources live in the repository root proto/ directory; bindings are generated at build time and never committed. -->
    <Protobuf Include="..\..\..\..\proto\openshell.proto;..\..\..\..\proto\sandbox.proto;..\..\..\..\proto\datamodel.proto;..\..\..\..\proto\options.proto"
              ProtoRoot="..\..\..\..\proto" GrpcServices="Client" Access="Public" Link="Proto\%(Filename)%(Extension)" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="$(InternalsVisibleToTests)" />
    <InternalsVisibleTo Include="OpenShell.Sdk.DependencyInjection.Tests" />
  </ItemGroup>
</Project>
